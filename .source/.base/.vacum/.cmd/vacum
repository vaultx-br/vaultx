#!/usr/bin/env bash
set -Eeuo pipefail
base=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
stack=/opt/vaultwarden/.vws/docker-compose.yml
need_stack(){ [ -f "$stack" ] || { echo 'VACUM: nó não instalado; execute vacum install.' >&2; exit 1; }; }
cmd=${1:-help}; shift || :
case $cmd in
  install) exec "$base/install.sh" install "$@" ;;
  status) need_stack; sudo docker compose -f "$stack" ps ;;
  doctor)
    need_stack
    command -v docker >/dev/null || { echo 'VACUM: docker ausente' >&2; exit 1; }
    sudo test -f /run/vaultwarden/config.env || { echo 'VACUM: config runtime ausente' >&2; exit 1; }
    sudo docker compose -f "$stack" config -q
    sudo docker compose -f "$stack" ps --status running --quiet | grep -q . || { echo 'VACUM: nenhum serviço em execução' >&2; exit 1; }
    echo 'VACUM: OK'
    ;;
  test) bash -n "$base"/*.sh; sh -n "$base/../.bkp"/backup "$base/../.bkp"/entrypoint.sh; echo 'VACUM: TEST OK' ;;
  help|--help|-h) cat <<'EOF'
VACUM
  vacum install  instala o nó
  vacum status   mostra os serviços
  vacum doctor   valida a instalação
  vacum test     valida scripts
EOF
    ;;
  *) echo "comando inválido: $cmd" >&2; exit 2 ;;
esac
