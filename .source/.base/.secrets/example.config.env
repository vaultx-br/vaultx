# ============================================================
# Vaultwarden
# ============================================================
DOMAIN=https://vault.example.com
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false
ADMIN_TOKEN=change-me

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=vault@example.com
SMTP_FROM_NAME=Vaultwarden
SMTP_TIMEOUT=15

# ============================================================
# Cloudflare Tunnel
# ============================================================
CF_TUNNEL_TOKEN=change-me

# ============================================================
# Self-hosted ntfy
# ============================================================
NTFY_URL=http://ntfy
NTFY_TOPIC=vaultwarden-backup
# NTFY_TOKEN=change-me  # reserved; Backup SVC ainda não usa este campo

# ============================================================
# Backup policy
# ============================================================
TZ=America/Fortaleza
BACKUP_MINUTE=33
BACKUP_HOUR=3
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
BACKUP_MAX_BYTES=4294967296

# ============================================================
# Git synchronization
# ============================================================
GIT_1_OWNER=OWNER
GIT_1_REPO=REPOSITORY
GIT_1_PAT=change-me
# GIT_2_OWNER=SECOND_OWNER
# GIT_2_REPO=SECOND_REPOSITORY
# GIT_2_PAT=change-me

# ============================================================
# Restic node 1 — Cloudflare R2
# ============================================================
RESTIC_1_ENABLED=true
RESTIC_1_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET_NAME
RESTIC_1_ACCESS_KEY=change-me
RESTIC_1_SECRET_KEY=change-me
RESTIC_1_PASSWORD=change-me

# ============================================================
# Restic node 2 — template for another S3-compatible provider
# ============================================================
# RESTIC_2_ENABLED=false
# RESTIC_2_REPOSITORY=s3:https://ENDPOINT/BUCKET_NAME
# RESTIC_2_ACCESS_KEY=change-me
# RESTIC_2_SECRET_KEY=change-me
# RESTIC_2_PASSWORD=change-me
