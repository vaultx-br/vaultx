#!/usr/bin/env bash
set -Eeuo pipefail
self=$(realpath -e "${BASH_SOURCE[0]}")
base=$(dirname "$self")
cmd_dir=$base
stack=/opt/vaultwarden/.vws/docker-compose.yml
need_stack(){ sudo test -f "$stack" || { echo 'VACUM: nó não instalado; execute vacum install.' >&2; exit 1; }; }
menu(){
  cat >&2 <<'EOF'

██╗   ██╗ █████╗  ██████╗██╗   ██╗███╗   ███╗
██║   ██║██╔══██╗██╔════╝██║   ██║████╗ ████║
██║   ██║███████║██║     ██║   ██║██╔████╔██║
╚██╗ ██╔╝██╔══██║██║     ██║   ██║██║╚██╔╝██║
 ╚████╔╝ ██║  ██║╚██████╗╚██████╔╝██║ ╚═╝ ██║
  ╚═══╝  ╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═╝     ╚═╝

[1] INSTALL
[2] STATUS
[3] DOCTOR
[4] TEST

[0] EXIT
EOF
  printf '> ' >&2; IFS= read -r choice </dev/tty
  case $choice in
    0) exit 0;;
    1|2|3|4)
      case $choice in 1) action=install;; 2) action=status;; 3) action=doctor;; 4) action=test;; esac
      "$self" "$action" || :
      printf '\nPressione Enter para voltar ao menu... ' >&2
      IFS= read -r _ </dev/tty
      menu
      ;;
    *) echo 'opção inválida' >&2; menu;;
  esac
}
if (($# == 0)); then
  [ -t 0 ] && menu
  set -- help
fi
cmd=$1; shift
case $cmd in
  install) exec "$cmd_dir/install.sh" install "$@" ;;
  status) need_stack; sudo docker compose -f "$stack" ps ;;
  doctor)
    need_stack
    command -v docker >/dev/null || { echo 'VACUM: docker ausente' >&2; exit 1; }
    sudo test -f /run/vaultwarden/config.env || { echo 'VACUM: config runtime ausente' >&2; exit 1; }
    sudo docker compose -f "$stack" config -q
    sudo docker compose -f "$stack" ps --status running --quiet | grep -q . || { echo 'VACUM: nenhum serviço em execução' >&2; exit 1; }
    echo 'VACUM: OK'
    ;;
  test) bash -n "$cmd_dir"/*.sh "$self"; sh -n "$cmd_dir/../.bkp"/backup "$cmd_dir/../.bkp"/entrypoint.sh; echo 'VACUM: TEST OK' ;;
  help|--help|-h) cat <<'EOF'
VACUM
  vacum install  instala o nó
  vacum status   mostra os serviços
  vacum doctor   valida a instalação
  vacum test     valida scripts
EOF
    ;;
  *) echo "comando inválido: $cmd" >&2; exit 2 ;;
esac
